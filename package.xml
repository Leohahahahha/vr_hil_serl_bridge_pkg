<?xml version="1.0"?>
<package format="3">
  <name>vive_teleop_tactile_bridge</name>
  <version>0.1.0</version>
  <description>HTC VR to HIL-SERL Franka HTTP bridge for ROS 2 on Ubuntu 24.04.</description>

  <maintainer email="support@example.com">OpenAI</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>paxini_tactile</exec_depend>
  <exec_depend>tashan_tactile</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-zarr</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
